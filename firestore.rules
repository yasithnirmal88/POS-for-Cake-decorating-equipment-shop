rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }

    // ---------------------------------------------------------
    // TEMPORARILY RELAXED RULES
    // Since your Auth UIDs do not currently match your 'users' 
    // document IDs, strict role checks will fail. 
    // For now, we allow any logged-in user to read/write.
    // ---------------------------------------------------------
    
    match /users/{userId} {
      allow read, write: if isAuthenticated();
    }

    match /products/{productId} {
      allow read, write: if isAuthenticated();
    }

    match /sales/{saleId} {
      allow read, write: if isAuthenticated();
    }

    match /inventory/{itemId} {
      allow read, write: if isAuthenticated();
    }
    
    match /stock_movements/{movementId} {
      allow read, write: if isAuthenticated();
    }
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
